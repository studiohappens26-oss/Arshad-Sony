---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { store, storeJsonLd, specsFor, inr, productUrl, categories, waLink, enquiryText, shortName, type Product } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object[];
  products?: Product[];
  loader?: boolean;
  noindex?: boolean;
}
const { title, description, image = '/images/banners/bravia-banner.webp', jsonLd = [], products = [], loader = false, noindex = false } = Astro.props;
// SST (Sony's typeface, as on shopatsc.com) is used when licensed files are placed in public/fonts/sst/
const sstWeights: [string, number][] = [['Light', 300], ['Roman', 400], ['Medium', 500], ['Bold', 700]];
const sstFaces = sstWeights
  .filter(([n]) => fs.existsSync(path.join(process.cwd(), 'public/fonts/sst', `SST-${n}.woff2`)))
  .map(([n, w]) => `@font-face{font-family:"SST";src:url(/fonts/sst/SST-${n}.woff2) format("woff2");font-weight:${w};font-style:normal;font-display:swap}`)
  .join('');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ld = [storeJsonLd(Astro.site), ...jsonLd];
// compact data for the quick-view dialog
const quick = products.map(p => ({
  id: p.slug, name: p.name, short: shortName(p), model: p.model, image: p.image, cat: categories[p.category].single,
  price: inr(p.price), mrp: p.mrp ? inr(p.mrp) : '', url: productUrl(p), wa: waLink(enquiryText(p)), specs: specsFor(p)
}));
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#5B0714" />
  <link rel="icon" href="/brand/logo-mark.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${store.name}, ${store.area}`} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="IN-KA" />
  <meta name="geo.placename" content={`${store.area}, ${store.city}`} />
  {sstFaces ? <style is:inline set:html={sstFaces} /> : <link rel="preload" href="/fonts/source-sans-3.woff2" as="font" type="font/woff2" crossorigin />}
  {ld.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body class={loader ? 'is-loading' : ''}>
  <a class="skip" href="#main">Skip to content</a>

  {loader && (
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader__inner">
        <svg class="loader__mark" viewBox="0 0 48 48">
          <rect x="1.5" y="4" width="45" height="32" rx="6"/>
          <path d="M19 44h10M24 36v8"/>
          <path d="M14 29V12h7.5a5 5 0 0 1 0 10H14M20 22l6 7"/>
          <path d="M31.5 16.5a4 4 0 0 1 0 8"/><path d="M35.5 13a9 9 0 0 1 0 15"/>
        </svg>
        <div class="loader__bar"><i id="loaderBar"></i></div>
      </div>
    </div>
  )}

  <div class="cursor" id="cursor" aria-hidden="true">
    <div class="cursor__dot"></div>
    <div class="cursor__ring">
      <svg class="ci ci--tv" viewBox="0 0 48 48"><rect x="6" y="10" width="36" height="23" rx="2.5"/><rect class="ci-screen" x="9" y="13" width="30" height="17" rx="1"/><path d="M18 39h12M24 33v6"/></svg>
      <svg class="ci ci--hp" viewBox="0 0 48 48"><path d="M11 30v-6a13 13 0 0 1 26 0v6"/><rect x="8" y="27" width="7" height="12" rx="3"/><rect x="33" y="27" width="7" height="12" rx="3"/><path class="ci-wave w1" d="M3.5 29.5a7 7 0 0 0 0 9"/><path class="ci-wave w2" d="M44.5 29.5a7 7 0 0 1 0 9"/></svg>
      <svg class="ci ci--sb" viewBox="0 0 48 48"><rect class="eq e1" x="10" y="13" width="3" height="18" rx="1.5"/><rect class="eq e2" x="17" y="13" width="3" height="18" rx="1.5"/><rect class="eq e3" x="24" y="13" width="3" height="18" rx="1.5"/><rect class="eq e4" x="31" y="13" width="3" height="18" rx="1.5"/><rect class="eq e5" x="38" y="13" width="3" height="18" rx="1.5"/><rect class="eq-base" x="6" y="35" width="38" height="5" rx="2.5"/></svg>
      <span class="cursor__label" id="cursorLabel"></span>
    </div>
  </div>
  <div class="progress" id="progress"></div>

  <Header />
  <main id="main"><slot /></main>
  <Footer />

  <a class="wa-fab" href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noopener" aria-label="Enquire on WhatsApp"><Icon name="wa" size={20} /><span>Enquire</span></a>
  <div class="buddy" id="buddy">
    <button class="buddy__body" id="buddyBody" aria-label="Rudy, the RDL mascot. Click for a tip"></button>
    <div class="buddy__bubble" id="buddyBubble" role="status" aria-live="polite"></div>
  </div>

  {quick.length > 0 && (
    <>
      <script type="application/json" id="quickData" set:html={JSON.stringify(quick)} />
      <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle" hidden>
        <div class="modal__backdrop" data-close></div>
        <div class="modal__card">
          <button class="modal__close" data-close aria-label="Close">×</button>
          <div class="modal__img"><img id="mImg" alt="" /></div>
          <div class="modal__body">
            <span class="kicker" id="mCat"></span>
            <h2 class="modal__title" id="mTitle"></h2>
            <div class="modal__price" id="mPrice"></div>
            <ul class="specs" id="mSpecs"></ul>
            <div class="btn-row">
              <a class="btn btn--primary" id="mWa" target="_blank" rel="noopener">Enquire now</a>
              <a class="btn btn--outline" href={`tel:${store.phone}`}>Call now</a>
              <a class="link" id="mUrl" href="#">Full details <span class="arr">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </>
  )}

  <script>
    import '../scripts/mascot.js';
    import '../scripts/main.js';
  </script>
</body>
</html>
