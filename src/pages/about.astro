---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import About from '../components/sections/About.astro';
import Showroom from '../components/sections/Showroom.astro';
import { store } from '../lib/site';
---
<Base title={`About ${store.name} | Sony Authorised Dealer, ${store.area}, Bengaluru`}
  description={`${store.name}, ${store.area} is a trusted Sony electronics retailer in Bangalore offering genuine Sony TVs from 32" to 98" and premium audio at competitive prices.`}>
  <PageHead crumbs={[['Home', '/'], ['About']]} title="About RDL Sony" lede="At RDL Sony, we deliver authentic Sony electronics with unbeatable prices and exceptional customer support in Bangalore." mascot="about" section="about" />
  <About />
  <Showroom />
</Base>
