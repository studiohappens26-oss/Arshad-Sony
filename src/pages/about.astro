---
import Base from '../layouts/Base.astro';
import About from '../components/sections/About.astro';
import Why from '../components/sections/Why.astro';
import Gallery from '../components/sections/Gallery.astro';
import Visit from '../components/sections/Visit.astro';
import { store } from '../lib/site';
---
<Base title={`About ${store.name} | Sony Authorised Dealer, ${store.area}, Bengaluru`}
  description={`${store.name}, ${store.area} is a trusted Sony electronics retailer in Bangalore offering genuine Sony TVs from 32" to 98" and premium audio at competitive prices.`}>
  <nav class="crumbs container" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></nav>
  <About level="h1" />
  <Why />
  <Gallery />
  <Visit />
</Base>
