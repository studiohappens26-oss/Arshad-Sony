---
import Variant from '../../layouts/Variant.astro';
import { getProducts, categories, inr, productUrl, shortName, subName, waLink, enquiryText, telLink, directionsLink, store, minPrice } from '../../lib/site';

const all = await getProducts();
const hero = all.find(p => p.slug === 'k-85xr90')!;
const pick = ['k-65xr80', 'k-55xr70', 'wh-1000xm5', 'ht-a3000-51', 'k-43s25m2', 'wh-ult900n']
  .map(s => all.find(p => p.slug === s)).filter(Boolean) as typeof all;
const rows = (['tv', 'headphones', 'soundbars'] as const).map(k => {
  const list = all.filter(p => p.category === k);
  const img = { tv: '/images/products/k-65xr80.webp', headphones: '/images/products/wh-1000xm5.webp', soundbars: '/images/products/ht-s400.webp' }[k];
  return { href: `/${categories[k].slug}/`, label: categories[k].label, count: list.length, from: minPrice(list), img };
});
---
<Variant title="Minimal" variant="minimal" bodyClass="vm">
  <header class="vm-head">
    <a href="/variations/minimal/" class="vm-brand"><b>RDL</b> Sony Centre, HSR Layout</a>
    <nav class="vm-nav" aria-label="Primary">
      <a href="/televisions/">Televisions</a><a href="/headphones/">Headphones</a><a href="/soundbars/">Soundbars</a><a href="#visit">Visit</a>
    </nav>
    <span class="vm-auth"><b>SONY</b><i></i>Authorised Dealer</span>
  </header>

  <main>
    <section class="vm-hero">
      <p class="vm-small vm-fade">Authorised Sony dealer · HSR Layout, Bengaluru</p>
      <img class="vm-hero__img vm-fade" style="--d:.15s" src={hero.image} alt={hero.name} />
      <h1 class="vm-fade" style="--d:.3s">BRAVIA 9</h1>
      <p class="vm-muted vm-fade" style="--d:.4s">{hero.size}-inch {hero.panel}. {inr(hero.price)}.</p>
      <p class="vm-links vm-fade" style="--d:.5s">
        <a href={waLink(enquiryText(hero))} target="_blank" rel="noopener">Enquire →</a>
        <a href={productUrl(hero)}>Details →</a>
      </p>
    </section>

    <section class="vm-statement">
      <p class="vm-reveal">Every Sony we sell is genuine, and priced to beat anyone in Bangalore.</p>
    </section>

    <section class="vm-index" aria-label="Shop by category">
      {rows.map(r => (
        <a class="vm-row" href={r.href} data-img={r.img}>
          <span class="vm-row__label">{r.label}</span>
          <span class="vm-row__meta">{r.count} models · from {inr(r.from)}</span>
          <span class="vm-row__arr" aria-hidden="true">→</span>
        </a>
      ))}
      <img class="vm-peek" id="peek" alt="" aria-hidden="true" />
    </section>

    <section class="vm-grid-wrap">
      <p class="vm-small">Selected</p>
      <div class="vm-grid">
        {pick.map(p => (
          <a class="vm-card vm-reveal" href={productUrl(p)}>
            <span class="vm-card__img"><img src={p.image} alt={p.name} loading="lazy" /></span>
            <span class="vm-card__name">{shortName(p)}</span>
            <span class="vm-card__sub">{subName(p)}</span>
            <span class="vm-card__price">{inr(p.price)}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="vm-visit" id="visit">
      <p class="vm-small">Visit</p>
      <div>
        <address class="vm-addr">{store.streetAddress},<br />{store.locality} {store.postalCode}</address>
        <p class="vm-muted">Open {store.hoursText} · {store.phoneDisplay} · {store.email}</p>
        <p class="vm-links">
          <a href={directionsLink} target="_blank" rel="noopener">Get directions →</a>
          <a href={telLink}>Call now →</a>
          <a href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noopener">WhatsApp →</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="vm-foot">
    <span class="vm-foot__rudy" data-mascot="hero"></span>
    <span>© {new Date().getFullYear()} {store.name}</span>
    <span class="vm-auth"><b>SONY</b><i></i>Authorised Dealer</span>
  </footer>

  <script>
    import '../../scripts/mascot.js';
    document.querySelectorAll<HTMLElement>('[data-mascot]').forEach(el => { el.innerHTML = (window as any).Rudy.svg(el.dataset.mascot); });

    // gentle reveal
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: .15 });
    document.querySelectorAll('.vm-reveal').forEach(el => io.observe(el));

    // category rows: product preview follows the cursor
    const peek = document.getElementById('peek') as HTMLImageElement;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let x = 0, y = 0, px = 0, py = 0;
    if (fine) {
      document.querySelectorAll<HTMLElement>('.vm-row').forEach(r => {
        r.addEventListener('mouseenter', () => { peek.src = r.dataset.img!; peek.classList.add('is-on'); });
        r.addEventListener('mouseleave', () => peek.classList.remove('is-on'));
      });
      addEventListener('mousemove', e => { x = e.clientX; y = e.clientY; }, { passive: true });
      const loop = () => { px += (x - px) * .15; py += (y - py) * .15; peek.style.transform = `translate(${px}px, ${py}px) translate(-50%, -50%)`; requestAnimationFrame(loop); };
      loop();
    }
  </script>
</Variant>

<style is:global>
  .vm { margin: 0; background: #fff; color: #111; font: 400 17px/1.55 "SST", "Source Sans 3", "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  .vm a { color: inherit; text-decoration: none; }
  .vm img { max-width: 100%; height: auto; display: block; }
  .vm h1 { font-weight: 400; font-size: clamp(2rem, 3.4vw, 3rem); letter-spacing: -0.02em; margin: 0 0 6px; }
  .vm-small { font-size: 13px; letter-spacing: .04em; color: #8a8a8a; margin: 0 0 28px; }
  .vm-muted { color: #8a8a8a; margin: 0; }
  .vm-links { display: flex; gap: 28px; flex-wrap: wrap; margin: 22px 0 0; }
  .vm-links a { border-bottom: 1px solid transparent; transition: border-color .3s; }
  .vm-links a:hover { border-color: currentColor; }

  .vm-head { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 40px; height: 64px; padding: 0 clamp(20px, 4vw, 56px); background: rgba(255, 255, 255, .92); backdrop-filter: blur(12px); font-size: 14px; }
  .vm-brand { color: #8a8a8a; } .vm-brand b { color: #111; letter-spacing: .12em; margin-right: 6px; }
  .vm-nav { display: flex; gap: 28px; margin-left: auto; color: #555; }
  .vm-nav a:hover { color: #111; }
  .vm-auth { display: inline-flex; align-items: center; gap: 10px; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: #8a8a8a; }
  .vm-auth b { font-size: 13px; letter-spacing: .3em; color: #111; }
  .vm-auth i { width: 1px; height: 16px; background: #ccc; }

  .vm-hero { min-height: calc(100svh - 64px); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 20px 80px; }
  .vm-hero__img { width: min(860px, 92vw); margin: 0 auto 40px; }
  .vm-fade { opacity: 0; transform: translateY(14px); animation: vmIn 1.2s cubic-bezier(.16, 1, .3, 1) forwards; animation-delay: var(--d, 0s); }
  @keyframes vmIn { to { opacity: 1; transform: none; } }

  .vm-statement { padding: clamp(100px, 16vw, 220px) 20px; display: grid; place-items: center; border-top: 1px solid #eee; }
  .vm-statement p { max-width: 920px; text-align: center; font-size: clamp(1.8rem, 3.6vw, 3.2rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.18; margin: 0; }

  .vm-index { position: relative; border-top: 1px solid #eee; }
  .vm-row { display: grid; grid-template-columns: 1fr auto 40px; align-items: baseline; gap: 20px; padding: clamp(26px, 4vw, 44px) clamp(20px, 4vw, 56px); border-bottom: 1px solid #eee; transition: background .4s; }
  .vm-row:hover { background: #fafafa; }
  .vm-row__label { font-size: clamp(2rem, 5vw, 4.4rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1; }
  .vm-row__meta { color: #8a8a8a; font-size: 15px; }
  .vm-row__arr { text-align: right; transition: transform .4s; }
  .vm-row:hover .vm-row__arr { transform: translateX(6px); }
  .vm-peek { position: fixed; left: 0; top: 0; width: 280px; pointer-events: none; z-index: 5; opacity: 0; transition: opacity .3s; filter: drop-shadow(0 20px 20px rgba(0, 0, 0, .12)); }
  .vm-peek.is-on { opacity: 1; }

  .vm-grid-wrap { padding: clamp(90px, 12vw, 160px) clamp(20px, 4vw, 56px); }
  .vm-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 80px 40px; }
  .vm-card { display: flex; flex-direction: column; gap: 4px; }
  .vm-card__img { position: relative; display: block; aspect-ratio: 4 / 3; margin-bottom: 18px; }
  .vm-card__img img { position: absolute; inset: 6% 10%; width: 80%; height: 88%; object-fit: contain; transition: transform .9s cubic-bezier(.16, 1, .3, 1); }
  .vm-card:hover .vm-card__img img { transform: scale(1.04); }
  .vm-card__name { font-size: 18px; }
  .vm-card__sub { color: #8a8a8a; font-size: 14px; }
  .vm-card__price { font-size: 15px; margin-top: 6px; }
  .vm-reveal { opacity: 0; transform: translateY(18px); transition: opacity 1.1s ease, transform 1.1s cubic-bezier(.16, 1, .3, 1); }
  .vm-reveal.is-in { opacity: 1; transform: none; }

  .vm-visit { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; padding: clamp(90px, 12vw, 160px) clamp(20px, 4vw, 56px); border-top: 1px solid #eee; }
  .vm-addr { font-style: normal; font-size: clamp(1.6rem, 3vw, 2.6rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 20px; }

  .vm-foot { display: flex; align-items: center; gap: 20px; justify-content: space-between; padding: 28px clamp(20px, 4vw, 56px) 96px; border-top: 1px solid #eee; font-size: 13px; color: #8a8a8a; }
  .vm-foot__rudy { width: 44px; }
  .vm-foot > span:nth-child(2) { margin-right: auto; }

  @media (max-width: 860px) {
    .vm-nav, .vm-head .vm-auth { display: none; }
    .vm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 50px 18px; }
    .vm-row { grid-template-columns: 1fr 30px; }
    .vm-row__meta { grid-column: 1; grid-row: 2; }
    .vm-visit { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .vm-fade, .vm-reveal { animation: none; opacity: 1; transform: none; transition: none; } }
</style>
