---
import Variant from '../../layouts/Variant.astro';
import { variants } from '../../lib/variants';
import { store } from '../../lib/site';
const swatches: Record<string, string[]> = {
  original: ['#ffffff', '#f7f4f1', '#5B0714', '#9c6a47'],
  minimal: ['#ffffff', '#eeeeee', '#8a8a8a', '#111111'],
  '3d': ['#f8f2ed', '#141416', '#5B0714', '#c08a65'],
  monogram: ['#ffffff', '#f7f4f1', '#5B0714', '#000000'],
  champagne: ['#fffdf9', '#f2ebdf', '#151515', '#a3803b'],
  cobalt: ['#ffffff', '#eef1f6', '#1f4fd6', '#0c1322'],
  sage: ['#fbfaf6', '#ebe9e0', '#2e4a39', '#8a7745']
};
---
<Variant title="Design variations" variant="" bodyClass="vi">
  <main class="vi-wrap">
    <p class="vi-kicker">{store.name} · Design review</p>
    <h1>Seven directions, one store.</h1>
    <p class="vi-lede">Each variation uses the same content, catalogue, SEO and CMS. Pick one to explore; the bar at the bottom switches between them. The colour themes carry across the whole site while you browse.</p>
    <div class="vi-grid">
      {variants.map((v, i) => (
        <a class="vi-card" href={v.href}>
          <span class="vi-shot"><img src={`/variations/shots/${v.key}.webp`} alt={`${v.label} design preview`} loading={i < 3 ? 'eager' : 'lazy'} /></span>
          <span class="vi-meta">
            <span class="vi-num">0{i + 1}</span>
            <span class="vi-name">{v.label}</span>
            <span class="vi-sw">{swatches[v.key].map(c => <i style={`background:${c}`}></i>)}</span>
          </span>
          <span class="vi-note">{v.note}</span>
        </a>
      ))}
    </div>
  </main>
</Variant>

<style is:global>
  .vi { margin: 0; background: #f6f4f2; color: #17100f; font: 400 17px/1.55 "SST", "Source Sans 3", "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  .vi a { color: inherit; text-decoration: none; }
  .vi-wrap { width: min(1360px, 100% - 48px); margin: 0 auto; padding: 90px 0 140px; }
  .vi-kicker { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: #5B0714; font-weight: 500; margin: 0 0 18px; }
  .vi h1 { font-size: clamp(2.6rem, 5.4vw, 5rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1; margin: 0 0 22px; }
  .vi-lede { max-width: 640px; color: #6b605d; margin: 0 0 64px; font-size: 1.1rem; }
  .vi-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 28px; }
  .vi-card { display: flex; flex-direction: column; gap: 14px; }
  .vi-shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #e8e3de; box-shadow: 0 30px 60px -40px rgba(0, 0, 0, .45); }
  .vi-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1.2s cubic-bezier(.16, 1, .3, 1); }
  .vi-card:hover .vi-shot img { transform: scale(1.03); }
  .vi-meta { display: flex; align-items: center; gap: 14px; }
  .vi-num { font-size: .8rem; color: #9c6a47; font-weight: 500; letter-spacing: .08em; }
  .vi-name { font-size: 1.4rem; font-weight: 400; letter-spacing: -0.02em; }
  .vi-sw { margin-left: auto; display: flex; }
  .vi-sw i { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, .12); margin-left: -5px; }
  .vi-note { color: #6b605d; font-size: .95rem; }
  @media (max-width: 960px) { .vi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .vi-grid { grid-template-columns: 1fr; } }
</style>
