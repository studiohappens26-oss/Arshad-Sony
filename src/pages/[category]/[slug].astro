---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import Auth from '../../components/Auth.astro';
import Showroom from '../../components/sections/Showroom.astro';
import {
  getProducts, categories, productUrl, inr, specsFor, describe, seoTitle, shortName, waLink, enquiryText, telLink, directionsLink, store, type Product
} from '../../lib/site';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map(p => ({ params: { category: categories[p.category].slug, slug: p.slug }, props: { p, all } }));
}
const { p, all } = Astro.props as { p: Product; all: Product[] };
const cat = categories[p.category];
const related = all.filter(x => x.category === p.category && x.slug !== p.slug)
  .sort((a, b) => Math.abs(a.price - p.price) - Math.abs(b.price - p.price)).slice(0, 4);
const save = p.mrp ? Math.round((1 - p.price / p.mrp) * 100) : 0;
const site = Astro.site;
const url = new URL(productUrl(p), site).href;
const text = describe(p);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Product',
    name: p.name, sku: p.model, mpn: p.model, image: new URL(p.image, site).href, description: text,
    brand: { '@type': 'Brand', name: 'Sony' },
    category: cat.single,
    offers: {
      '@type': 'Offer', url, priceCurrency: 'INR', price: p.price,
      availability: 'https://schema.org/InStoreOnly', itemCondition: 'https://schema.org/NewCondition',
      seller: { '@id': new URL('/#store', site).href }
    }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(`/${cat.slug}/`, site).href },
      { '@type': 'ListItem', position: 3, name: p.model, item: url }
    ]
  }
];
---
<Base title={seoTitle(p)} description={`${text} ${inr(p.price)}. Call ${store.phoneDisplay} or WhatsApp to enquire.`} image={p.image} jsonLd={jsonLd} products={related}>
  <section class="pdp" data-section={cat.cursor}>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${cat.slug}/`}>{cat.label}</a><span aria-hidden="true">/</span><span aria-current="page">{p.model}</span>
      </nav>
      <div class="pdp__grid">
        <div class="pdp__media" data-cursor={cat.cursor} data-cursor-label={shortName(p)}>
          <img class="ambi" src={p.image} alt="" aria-hidden="true" />
          <img src={p.image} alt={p.name} fetchpriority="high" />
        </div>
        <div class="pdp__info">
          <span class="kicker reveal">{shortName(p)}{save > 0 ? ` · Save ${save}%` : ''}</span>
          <h1 class="pdp__title reveal">{p.name}</h1>
          <p class="pdp__price reveal">{inr(p.price)}{p.mrp ? <s>{inr(p.mrp)}</s> : null}</p>
          <p class="pdp__note reveal">Prices change with offers. Call or WhatsApp for today’s best price.</p>
          <p class="pdp__desc reveal">{text}</p>
          <div class="btn-row reveal">
            <a class="btn btn--primary magnetic" href={waLink(enquiryText(p))} target="_blank" rel="noopener"><Icon name="wa" /> Enquire now</a>
            <a class="btn btn--outline magnetic" href={telLink}><Icon name="phone" /> Call now</a>
            <a class="btn btn--outline magnetic" href={directionsLink} target="_blank" rel="noopener"><Icon name="pin" /> Visit the shop</a>
          </div>
          <ul class="specs reveal">{specsFor(p).map(([k, v]) => <li><small>{k}</small><span>{v}</span></li>)}</ul>
          <div class="reveal" style="margin-top:34px"><Auth size="lg" /></div>
        </div>
      </div>
    </div>
  </section>
  {related.length > 0 && (
    <section class="section s-paper" data-section={cat.cursor} data-cursor={cat.cursor}>
      <div class="container">
        <div class="sec-head">
          <h2 class="h2 lines"><span class="ln"><span style="--i:0">More {cat.label.toLowerCase()}</span></span></h2>
          <a href={`/${cat.slug}/`} class="link reveal" style="justify-self:end">View all {cat.label.toLowerCase()} <span class="arr">→</span></a>
        </div>
        <div class="grid grid--4">{related.map(r => <ProductCard p={r} />)}</div>
      </div>
    </section>
  )}
  <Showroom />
</Base>
