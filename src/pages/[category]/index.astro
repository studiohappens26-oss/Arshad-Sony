---
import Base from '../../layouts/Base.astro';
import TvSection from '../../components/sections/TvSection.astro';
import HeadphonesSection from '../../components/sections/HeadphonesSection.astro';
import SoundbarsSection from '../../components/sections/SoundbarsSection.astro';
import Flagships from '../../components/sections/Flagships.astro';
import Showroom from '../../components/sections/Showroom.astro';
import PageHead from '../../components/PageHead.astro';
import { getProducts, categories, productUrl, store, inr, type Category } from '../../lib/site';

export function getStaticPaths() {
  return (Object.keys(categories) as Category[]).map(key => ({ params: { category: categories[key].slug }, props: { key } }));
}
const { key } = Astro.props as { key: Category };
const cat = categories[key];
const products = await getProducts(key);
const min = Math.min(...products.map(p => p.price));

const meta = {
  tv: {
    title: `Sony BRAVIA TV Price in Bangalore: 32" to 85" | ${store.name}, ${store.area}`,
    description: `Compare ${products.length} Sony BRAVIA TVs (BRAVIA 2, 3, 7, 8, 9 and XR) from ₹${min.toLocaleString('en-IN')} at ${store.name}, a Sony authorised dealer in ${store.area}, Bengaluru. Call or WhatsApp for today's best price.`
  },
  headphones: {
    title: `Sony Headphones in Bangalore: WH-1000XM5, ULT WEAR & more | ${store.name}`,
    description: `Genuine Sony headphones including the WH-1000XM5, ULT WEAR WH-ULT900N and MDR-7506 at ${store.name}, ${store.area}, Bengaluru. Try them in store, call or WhatsApp to enquire.`
  },
  soundbars: {
    title: `Sony Soundbars & Home Theatre in Bangalore | ${store.name}, ${store.area}`,
    description: `Sony soundbars and home theatre systems, from the HT-S400 to the HT-A3000 with 360 Spatial Sound Mapping, at ${store.name}, ${store.area}, Bengaluru. Hear them in our demo room.`
  }
}[key];

const head = {
  tv: { title: 'Sony BRAVIA televisions', lede: 'Every BRAVIA we stock, from 32-inch HD Ready to 85-inch Mini LED and OLED. Compare them side by side at our HSR Layout showroom.' },
  headphones: { title: 'Sony headphones', lede: 'Noise-cancelling wireless, bass-forward ULT WEAR, studio monitors and everyday in-ears. Try them on in store.' },
  soundbars: { title: 'Sony soundbars & home theatre', lede: 'From a 2.1 soundbar with a wireless subwoofer to 360 Spatial Sound Mapping. Hear the difference in store.' }
}[key];
const flagships = key === 'tv' ? ['k-85xr90', 'k-65xr80', 'k-55xr70', 'xr-55x90l'].map(s => products.find(p => p.slug === s)).filter(Boolean) as typeof products : [];
const site = Astro.site;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(`/${cat.slug}/`, site).href }
    ]
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: `Sony ${cat.label} at ${store.name}`,
    itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(productUrl(p), site).href, name: p.name }))
  }
];
---
<Base title={meta.title} description={meta.description} products={products} jsonLd={jsonLd} image={products[0]?.image}>
  <PageHead crumbs={[['Home', '/'], [cat.label]]} title={head.title} lede={head.lede} mascot={cat.mascot} section={cat.cursor} cursor={cat.cursor}>
    <p class="muted" style="margin:0">{products.length} models · from {inr(min)}</p>
  </PageHead>
  {key === 'tv' && flagships.length > 0 && <Flagships products={flagships} />}
  {key === 'tv' && <TvSection products={products} heading={false} />}
  {key === 'headphones' && <HeadphonesSection products={products} heading={false} />}
  {key === 'soundbars' && <SoundbarsSection products={products} heading={false} />}
  <Showroom />
</Base>
