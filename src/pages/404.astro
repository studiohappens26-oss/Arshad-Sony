---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | RDL Sony Centre" description="This page could not be found." noindex>
  <section class="notfound" data-section="tv">
    <div class="container">
      <div class="notfound__mascot" data-mascot="tv"></div>
      <span class="kicker">404</span>
      <h1>No signal on this channel.</h1>
      <p class="lede" style="margin-inline:auto">The page you’re looking for has moved or doesn’t exist.</p>
      <div class="btn-row"><a class="btn btn--primary" href="/">Back to home</a><a class="btn btn--outline" href="/televisions/">Browse televisions</a></div>
    </div>
  </section>
</Base>
