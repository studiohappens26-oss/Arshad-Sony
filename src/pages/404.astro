---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | RDL Sony Centre" description="This page could not be found." noindex>
  <section class="section notfound" data-section="hero">
    <div class="container notfound__in">
      <div class="notfound__mascot" data-mascot="tv"></div>
      <p class="eyebrow">Error 404</p>
      <h1>No signal on <em>this channel.</em></h1>
      <p class="muted">The page you're looking for has moved or doesn't exist.</p>
      <div class="hero__cta"><a class="btn btn--solid" href="/">Back to home</a><a class="btn btn--ghost" href="/televisions/">Browse TVs</a></div>
    </div>
  </section>
</Base>
