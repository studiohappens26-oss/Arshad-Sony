---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Showroom from '../components/sections/Showroom.astro';
import Enquiry from '../components/sections/Enquiry.astro';
import { store } from '../lib/site';
---
<Base title={`Visit & Contact | ${store.name}, ${store.area}, Bengaluru`}
  description={`Visit ${store.name} at ${store.streetAddress}, ${store.locality} ${store.postalCode}. Call ${store.phoneDisplay}, email ${store.email}. Open ${store.hoursText}.`}>
  <PageHead crumbs={[['Home', '/'], ['Visit & contact']]} title="Visit & contact" lede="Contact us for enquiries, purchase assistance, or support. We respond promptly to all messages." mascot="contact" section="contact" />
  <Showroom />
  <Enquiry />
</Base>
