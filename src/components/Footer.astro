---
import Auth from './Auth.astro';
import { store, telLink, mapsLink } from '../lib/site';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="footer__big">RDL Sony Centre<br /><span class="serif">HSR Layout</span></p>
        <address class="footer__nap">
          <a href={mapsLink} target="_blank" rel="noopener">{store.streetAddress}, {store.locality}, {store.region} {store.postalCode}</a><br />
          <a href={telLink}>{store.phoneDisplay}</a> · <a href={`mailto:${store.email}`}>{store.email}</a><br />
          Open {store.hoursText}
        </address>
        <Auth size="lg" />
      </div>
      <div>
        <div class="footer__cols">
          <div><h2 class="footer__h">Shop</h2><a href="/televisions/">Televisions</a><a href="/headphones/">Headphones</a><a href="/soundbars/">Soundbars</a></div>
          <div><h2 class="footer__h">Store</h2><a href="/about/">About us</a><a href="/contact/">Visit &amp; contact</a><a href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></div>
          <div><h2 class="footer__h">Policies</h2><a href="/policies/#shipping">Shipping</a><a href="/policies/#terms">Terms</a><a href="/policies/#privacy">Privacy</a></div>
        </div>
        <form class="footer__offers" id="newsForm">
          <label class="sr" for="newsPhone">Your WhatsApp number for Sony offers</label>
          <input id="newsPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Get Sony offers on WhatsApp: your number" required pattern="[0-9+ ]{10,15}" />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="footer__base">
      <p>© {new Date().getFullYear()} {store.name}, {store.area}, {store.city}</p>
      <p>Sony, BRAVIA and related marks are trademarks of Sony Group Corporation or its affiliates.</p>
    </div>
  </div>
</footer>
