<section class="news" data-section="news">
  <div class="container news__in reveal">
    <div>
      <p class="eyebrow eyebrow--light">Join our Sony updates</p>
      <h2>Never miss a <em>Sony deal</em></h2>
      <p>Subscribe for the latest deals, new arrivals, and exclusive offers on Sony electronics.</p>
    </div>
    <form class="news__form" id="newsForm">
      <label class="sr" for="newsPhone">WhatsApp number</label>
      <input id="newsPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Your WhatsApp number" required pattern="[0-9+ ]{10,15}" />
      <button class="btn btn--rose magnetic" type="submit">Send me offers</button>
    </form>
  </div>
</section>
