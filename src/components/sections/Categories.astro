---
import { inr } from '../../lib/site';
interface Props { stats: Record<'tv' | 'headphones' | 'soundbars', { count: number; from: number }> }
const { stats } = Astro.props;
const cats = [
  { key: 'tv', href: '/televisions/', title: 'Televisions', img: '/images/products/k-65xr80.webp', cursor: 'tv', mascot: 'tv', label: 'BRAVIA 2, 3, 7, 8, 9 and XR' },
  { key: 'headphones', href: '/headphones/', title: 'Headphones', img: '/images/products/wh-1000xm5.webp', cursor: 'hp', mascot: 'hp', label: 'Wireless, noise cancelling and studio' },
  { key: 'soundbars', href: '/soundbars/', title: 'Soundbars', img: '/images/products/ht-a3000-51.webp', cursor: 'sb', mascot: 'sb', label: '2.1 to 5.1 channel home theatre' }
] as const;
---
<section class="section s-dark" data-section="categories">
  <div class="container">
    <div class="sec-head">
      <h2 class="h2 lines"><span class="ln"><span style="--i:0">Three ways</span></span><span class="ln"><span style="--i:1">to hear and see Sony.</span></span></h2>
      <p class="lede reveal">Visit our HSR Layout showroom to compare picture and sound before you decide.</p>
    </div>
    <div class="cats">
      {cats.map((c, i) => (
        <a href={c.href} class="cat reveal" style={`--d:${i * 120}ms`} data-cursor={c.cursor} data-cursor-label="Explore">
          <div class="cat__top"><span class="num">0{i + 1}</span><div class="cat__mascot" data-mascot={c.mascot}></div></div>
          <div class="cat__img"><img src={c.img} alt="" loading="lazy" /></div>
          <h3>{c.title}</h3>
          <p class="cat__meta">{stats[c.key].count} models · from {inr(stats[c.key].from)}<br />{c.label}</p>
          <span class="link">Explore {c.title.toLowerCase()} <span class="arr">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
