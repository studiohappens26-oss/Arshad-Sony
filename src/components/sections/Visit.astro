---
// "Visit the shop" call-to-action band: Call now · Enquire now · Get directions
import Icon from '../Icon.astro';
import { store, telLink, waLink, directionsLink } from '../../lib/site';
interface Props { topic?: string }
const { topic = 'a Sony product' } = Astro.props;
---
<section class="visit" data-section="contact">
  <div class="container visit__in reveal">
    <div class="visit__mascot" data-mascot="contact"></div>
    <div class="visit__copy">
      <p class="eyebrow">Visit the shop</p>
      <h2>See it, hear it, <em>take it home.</em></h2>
      <p>{store.streetAddress}, {store.locality} {store.postalCode} · Open {store.hoursText}</p>
    </div>
    <div class="visit__cta">
      <a class="btn btn--solid magnetic" href={telLink}><Icon name="phone" /> Call now</a>
      <a class="btn btn--ghost magnetic" href={waLink(`Hi ${store.name}, I'd like to enquire about ${topic}.`)} target="_blank" rel="noopener"><Icon name="wa" /> Enquire now</a>
      <a class="btn btn--ghost magnetic" href={directionsLink} target="_blank" rel="noopener"><Icon name="pin" /> Get directions</a>
    </div>
  </div>
</section>
