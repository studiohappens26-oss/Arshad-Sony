---
import ProductCard from '../ProductCard.astro';
import type { Product } from '../../lib/site';
interface Props { products: Product[]; heading?: boolean }
const { products, heading = true } = Astro.props;
---
<section class="section s-light" id="soundbars" data-section="sb" data-cursor="sb">
  <div class="container">
    {heading && (
      <div class="showcase showcase--flip">
        <div>
          <div class="showcase__mascot" data-mascot="sb"></div>
          <h2 class="h2 lines"><span class="ln"><span style="--i:0">Soundbars &amp;</span></span><span class="ln"><span style="--i:1">home theatre</span></span></h2>
          <p class="lede reveal">From a compact 2.1 soundbar with a wireless subwoofer to the HT-A3000 with 360 Spatial Sound Mapping. Pair one with a BRAVIA for cinema sound at home.</p>
          <a class="link reveal" href="/soundbars/">All soundbars <span class="arr">→</span></a>
        </div>
        <div class="showcase__media showcase__media--wide reveal">
          <img src="/images/banners/living-room-tv.webp" alt="A Sony BRAVIA TV and soundbar in a living room" loading="lazy" class="parallax-img" data-speed="0.12" />
        </div>
      </div>
    )}
    <div class="grid grid--4">{products.map(p => <ProductCard p={p} />)}</div>
  </div>
</section>
