---
import home from '../../content/settings/home.json';
import { store, telLink, directionsLink, mapsLink } from '../../lib/site';
interface Props { modelCount: number }
const { modelCount } = Astro.props;
---
<section class="hero" data-section="hero">
  <div class="hero__glow" data-speed="0.12"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="kicker reveal">{home.heroEyebrow}</span>
      <h1 class="display lines">
        <span class="ln"><span style="--i:0">{home.heroTitle}</span></span>
        <span class="ln"><span style="--i:1" class="serif">{home.heroTitleAccent}</span></span>
      </h1>
      <p class="lede reveal" style="--d:300ms">{home.heroLead}</p>
      <div class="btn-row reveal" style="--d:420ms">
        <a href={directionsLink} target="_blank" rel="noopener" class="btn btn--primary magnetic">Visit the showroom</a>
        <a href={telLink} class="btn btn--outline magnetic">Call {store.phoneDisplay}</a>
      </div>
    </div>
    <div class="hero__stage" id="heroStage" data-cursor="tv" data-cursor-label="BRAVIA 9">
      <div class="tvshow" id="tvshow">
        <img class="ambi" src="/images/products/k-85xr90.webp" alt="" aria-hidden="true" />
        <img src="/images/products/k-85xr90.webp" alt="Sony BRAVIA 9 85-inch Mini LED TV" width="802" height="461" fetchpriority="high" />
      </div>
    </div>
  </div>
  <div class="container">
    <dl class="hero__facts reveal" style="--d:600ms">
      <div><dt>Showroom</dt><dd><a href={mapsLink} target="_blank" rel="noopener">6th Main Rd, 7th Sector</a></dd></div>
      <div><dt>Hours</dt><dd>{store.hoursText}</dd></div>
      <div><dt>In store</dt><dd>{modelCount} Sony models</dd></div>
      <div><dt>Status</dt><dd>Sony authorised dealer</dd></div>
    </dl>
  </div>
</section>
