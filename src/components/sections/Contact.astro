---
import Icon from '../Icon.astro';
import { store, telLink, mapsLink, directionsLink } from '../../lib/site';
interface Props { level?: 'h1' | 'h2' }
const { level = 'h2' } = Astro.props;
const H = level;
---
<section class="section contact" id="contact" data-section="contact">
  <div class="container contact__grid">
    <div class="contact__info">
      <p class="eyebrow reveal">Contact</p>
      <H class="split">Get in <em>touch</em></H>
      <p class="reveal">Contact us for inquiries, purchase assistance, or support. We respond promptly to all messages.</p>
      <ul class="contact__list">
        <li class="reveal"><span class="ic"><Icon name="phone" size={22} /></span><div><small>Phone</small><a href={telLink}>{store.phoneDisplay}</a></div></li>
        <li class="reveal"><span class="ic"><Icon name="mail" size={22} /></span><div><small>Email</small><a href={`mailto:${store.email}`}>{store.email}</a></div></li>
        <li class="reveal"><span class="ic"><Icon name="pin" size={22} /></span><div><small>Address</small><a href={mapsLink} target="_blank" rel="noopener">{store.streetAddress}, {store.locality}, {store.region} {store.postalCode}</a></div></li>
        <li class="reveal"><span class="ic"><Icon name="clock" size={22} /></span><div><small>Office timing</small><span>{store.hoursText}</span></div></li>
      </ul>
      <div class="contact__cta reveal">
        <a class="btn btn--solid magnetic" href={telLink}>Call now</a>
        <a class="btn btn--ghost magnetic" href={directionsLink} target="_blank" rel="noopener">Visit the shop</a>
      </div>
      <div class="map reveal">
        <iframe title={`Map to ${store.name}, ${store.area}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${encodeURIComponent(store.mapsQuery)}&output=embed`}></iframe>
      </div>
    </div>
    <form class="contact__form reveal" id="contactForm" novalidate>
      <div class="contact__mascot" data-mascot="contact"></div>
      <h2 class="contact__form-title">Send an enquiry</h2>
      <p class="muted">Your message opens in WhatsApp, ready to send to the store.</p>
      <div class="field"><input id="cName" name="name" autocomplete="name" required placeholder=" " /><label for="cName">Your name</label></div>
      <div class="field"><input id="cPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder=" " pattern="[0-9+ ]{10,15}" /><label for="cPhone">Phone number</label></div>
      <div class="field field--select">
        <select id="cInterest" name="interest">
          <option>Televisions</option><option>Headphones</option><option>Soundbars</option><option>Something else</option>
        </select>
        <label for="cInterest">I'm interested in</label>
      </div>
      <div class="field"><textarea id="cMsg" name="message" rows="4" placeholder=" "></textarea><label for="cMsg">Message (model, size, budget…)</label></div>
      <p class="form-error" id="formError" role="alert"></p>
      <button class="btn btn--solid btn--block magnetic" type="submit">Enquire now on WhatsApp <span aria-hidden="true">→</span></button>
    </form>
  </div>
</section>
