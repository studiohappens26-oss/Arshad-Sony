---
import ProductCard from '../ProductCard.astro';
import type { Product } from '../../lib/site';
interface Props { products: Product[]; heading?: boolean }
const { products, heading = true } = Astro.props;
---
<section class="section s-deep" id="headphones" data-section="hp" data-cursor="hp">
  <div class="container">
    {heading && (
      <div class="showcase">
        <div>
          <div class="showcase__mascot" data-mascot="hp"></div>
          <h2 class="h2 lines"><span class="ln"><span style="--i:0">Headphones</span></span></h2>
          <p class="lede reveal">The WH-1000XM5 for noise cancelling on the commute, the ULT WEAR for bass, and the MDR-7506, a studio standard for decades. Try them on in store.</p>
          <a class="link reveal" href="/headphones/">All headphones <span class="arr">→</span></a>
        </div>
        <div class="showcase__media reveal">
          <img src="/images/banners/headphones-neon.webp" alt="Sony over-ear headphones lit in magenta and blue" loading="lazy" class="parallax-img" data-speed="0.14" />
        </div>
      </div>
    )}
    <div class="grid grid--4">{products.map(p => <ProductCard p={p} />)}</div>
  </div>
</section>
