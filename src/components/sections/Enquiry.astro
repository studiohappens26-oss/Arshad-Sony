<section class="section s-light" id="enquire" data-section="contact">
  <div class="container enq__grid">
    <div>
      <span class="kicker reveal">Enquire</span>
      <h2 class="h2 lines" style="margin-bottom:26px"><span class="ln"><span style="--i:0">Ask us anything.</span></span></h2>
      <p class="lede reveal">Prices, stock, which size suits your room. Your message opens in WhatsApp, ready to send to the store. We reply promptly.</p>
    </div>
    <form class="form reveal" id="contactForm" novalidate>
      <div class="field"><input id="cName" name="name" autocomplete="name" required placeholder=" " /><label for="cName">Your name</label></div>
      <div class="field"><input id="cPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder=" " pattern="[0-9+ ]{10,15}" /><label for="cPhone">Phone number</label></div>
      <div class="field field--full field--select">
        <select id="cInterest" name="interest">
          <option>Televisions</option><option>Headphones</option><option>Soundbars &amp; home theatre</option><option>Something else</option>
        </select>
        <label for="cInterest">Interested in</label>
      </div>
      <div class="field field--full"><textarea id="cMsg" name="message" rows="3" placeholder=" "></textarea><label for="cMsg">Model, screen size or budget (optional)</label></div>
      <div class="form__foot">
        <p class="form-error" id="formError" role="alert"></p>
        <button class="btn btn--dark magnetic" type="submit">Send on WhatsApp</button>
      </div>
    </form>
  </div>
</section>
