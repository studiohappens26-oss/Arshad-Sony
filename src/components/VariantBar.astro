---
import { variants } from '../lib/variants';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<nav class="vbar" aria-label="Design variations" data-current={current}>
  <a class="vbar__home" href="/variations/">Design variations</a>
  {variants.map(v => <a href={v.href} data-key={v.key} class={current === v.key ? 'is-on' : undefined} aria-current={current === v.key ? 'page' : undefined}>{v.label}</a>)}
</nav>
<script is:inline>
  (function () { try {
    var bar = document.currentScript.previousElementSibling, t = sessionStorage.getItem('rdl-theme');
    if (!bar.dataset.current && t) { var a = bar.querySelector('[data-key="' + t + '"]'); if (a) a.classList.add('is-on'); }
  } catch (e) {} })();
</script>
<style is:global>
  .vbar { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 1400; display: none; align-items: center; gap: 2px; padding: 5px; background: rgba(20, 16, 16, .92); color: #fff; border-radius: 999px; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, .5); backdrop-filter: blur(10px); font: 500 13px/1 "SST", "Source Sans 3", Arial, sans-serif; max-width: calc(100vw - 24px); flex-wrap: wrap; justify-content: center; }
  .is-preview .vbar, .vbar--always { display: flex; }
  .vbar a { padding: 9px 14px; border-radius: 999px; color: rgba(255, 255, 255, .72); white-space: nowrap; transition: background .3s, color .3s; cursor: pointer; }
  .vbar a:hover { color: #fff; background: rgba(255, 255, 255, .08); }
  .vbar a.is-on { background: #fff; color: #111; }
  .vbar__home { font-weight: 600; color: #fff !important; padding-right: 16px !important; border-right: 1px solid rgba(255, 255, 255, .15); border-radius: 999px 0 0 999px !important; margin-right: 4px; }
  .is-preview .wa-fab, .is-preview .buddy { bottom: 74px; }
  /* phones: just the current design and a link to all of them */
  @media (max-width: 560px) { .vbar { flex-wrap: nowrap; bottom: 10px; } .vbar a:not(.is-on):not(.vbar__home) { display: none; } .vbar__home { border-right: 0; margin-right: 0; } .vbar__home::after { content: ' ↗'; } }
</style>
