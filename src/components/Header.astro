---
import Logo from './Logo.astro';
import Auth from './Auth.astro';
import { store, telLink, directionsLink } from '../lib/site';
const path = Astro.url.pathname;
const links = [['/televisions/', 'Televisions'], ['/headphones/', 'Headphones'], ['/soundbars/', 'Soundbars'], ['/about/', 'About'], ['/contact/', 'Visit us']];
---
<header class="header" id="header">
  <div class="header__in">
    <a href="/" class="brand" aria-label={`${store.name}, home`}>
      <Logo class="brand__mark" />
      <span class="brand__text"><strong>RDL</strong><span>Sony Centre · HSR Layout</span></span>
    </a>
    <nav class="nav" id="nav" aria-label="Primary">
      {links.map(([href, label]) => <a href={href} class={path.startsWith(href) ? 'is-active' : undefined} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      <div class="nav__extra">
        <Auth />
        <a href={telLink}>Call {store.phoneDisplay}</a>
        <a href={directionsLink} target="_blank" rel="noopener">Get directions</a>
      </div>
    </nav>
    <div class="header__end">
      <a href="/about/" aria-label="Sony Authorised Dealer"><Auth /></a>
      <a href={telLink} class="btn btn--outline btn--sm header__call">Call now</a>
      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav"><i></i><i></i></button>
    </div>
  </div>
</header>
